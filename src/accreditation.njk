canonical: "/accreditation"
schemaJson: |
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {"@type":"Question","name":"Adakah program eDagang HRDC claimable?","acceptedAnswer":{"@type":"Answer","text":"Ya. Program eDagang diiktiraf oleh HRD Corp (Human Resource Development Corporation). Majikan yang berdaftar dengan HRD Corp boleh tuntut yuran latihan melalui akaun levy syarikat mereka."}},
      {"@type":"Question","name":"Berapa lama proses tuntutan HRDC?","acceptedAnswer":{"@type":"Answer","text":"Proses tuntutan HRDC biasanya mengambil masa 30 hingga 60 hari bekerja selepas permohonan lengkap dikemukakan."}},
      {"@type":"Question","name":"Siapa yang layak untuk tuntutan HRDC?","acceptedAnswer":{"@type":"Answer","text":"Majikan yang mendaftarkan syarikat dengan HRD Corp dan membayar levy latihan layak membuat tuntutan. Pekerja yang dicarum KWSP oleh majikan layak menyertai program yang dituntut."}}
