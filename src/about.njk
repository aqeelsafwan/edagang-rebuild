        <div class="origin-stat-divider"></div>
        <div class="origin-stat" style="position:relative;z-index:1"><div class="num">50,000+</div><div class="lbl">PKS aktif di platform Borong</div></div>
        <div class="origin-stat-divider"></div>
        <div class="origin-stat" style="position:relative;z-index:1;margin-bottom:0"><div class="num">MY + SG</div><div class="lbl">Beroperasi di Malaysia dan Singapura</div></div>
      </div>
    </div>
  </div>
</section>

