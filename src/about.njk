      <div class="origin-visual">
        <div style="font-size:13px;font-weight:700;color:rgba(255,255,255,0.4);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:28px;position:relative;z-index:1">Borong dalam Nombor</div>
        <div class="origin-stat" style="position:relative;z-index:1"><div class="num">2017</div><div class="lbl">Tahun diasaskan (sebagai Dropee)</div></div>
